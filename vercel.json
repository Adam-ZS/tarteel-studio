{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "memory": 2048,
        "includeFiles": [
          "public/**",
          "node_modules/ffmpeg-static/ffmpeg",
          "node_modules/ffprobe-static/bin/**",
          "node_modules/quran-json/dist/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
